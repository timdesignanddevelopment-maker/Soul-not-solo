PORT=4000

# AI provider: "nim" (NVIDIA NIM — default/production) or "anthropic" (Claude,
# alternative). Leave unset to use NVIDIA NIM.
MODEL_PROVIDER=nim
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Only needed if MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001
