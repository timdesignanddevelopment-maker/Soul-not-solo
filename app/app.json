{
  "expo": {
    "name": "Soul Not Solo",
    "slug": "soul-not-solo",
    "scheme": "soulnotsolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f2e8d0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.soulnotsolo.app"
    },
    "android": {
      "package": "com.soulnotsolo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#f2e8d0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
